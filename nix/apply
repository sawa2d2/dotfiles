#!/usr/bin/env bash
set -euo pipefail

nix_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

dry_run=false
case ${1:-} in
'') ;;
--dry-run) dry_run=true ;;
*)
  echo "Usage: nix/apply [--dry-run]" >&2
  exit 2
  ;;
esac

if ! command -v nix > /dev/null 2>&1; then
  echo "Error: Nix is not installed or not in PATH." >&2
  exit 1
fi

# Machine-specific settings remain outside version control.
if [[ -f "$nix_dir/local.env" ]]; then
  set -a
  source "$nix_dir/local.env"
  set +a
fi

# Default to the invoking user, while allowing explicit overrides.
export HOME_MANAGER_USER="${HOME_MANAGER_USER:-$(id -un)}"
export HOME_MANAGER_HOME="${HOME_MANAGER_HOME:-$HOME}"

if [[ "$HOME_MANAGER_HOME" != /* ]]; then
  echo "Error: HOME_MANAGER_HOME must be an absolute path." >&2
  exit 1
fi

case "$(uname -s):$(uname -m)" in
Linux:x86_64) configuration=ubuntu ;;
Darwin:arm64) configuration=macos ;;
*)
  echo "Error: unsupported host $(uname -s)/$(uname -m)." >&2
  exit 1
  ;;
esac

generation=$(nix build --impure --no-link --print-out-paths \
  "$nix_dir#homeConfigurations.$configuration.activationPackage")
if $dry_run; then
  echo "Built $generation (dry run; not activated)"
  exit 0
fi
exec "$generation/activate"
