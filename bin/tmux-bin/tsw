#!/usr/bin/env bash
set -euo pipefail

case $# in
  1)
    tmux swap-window -d -s . -t "$1"
    ;;
  2)
    tmux swap-window -d -s "$1" -t "$2"
    ;;
  *)
    echo "Usage: tsw [source-window] <target-window>" >&2
    exit 2
    ;;
esac

# The custom status bar caches window labels in session options.
# A swap may not trigger the hooks that refresh those cached labels.
bash "$(dirname "$0")/tmux-status-windows" --sync
