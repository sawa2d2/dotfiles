#!/usr/bin/env python3
"""Manual tmux session snapshots (layouts, directories, foreground commands)."""
import argparse
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote

DIR = Path.home() / ".local/state/tmux/sessions"

# Only relaunch explicitly approved interactive applications, without saved argv.
RESTORABLE_COMMANDS = frozenset({
    "vi", "vim", "nvim", "bob", "claude", "codex",
})

def tm(*args):
    p = subprocess.run(["tmux", *map(str, args)], capture_output=True, text=True)
    if p.returncode:
        raise RuntimeError(p.stderr.strip() or "tmux command failed")
    return p.stdout.rstrip("\n")

def records(*args, fields):
    fmt = "\t".join("#{" + field + "}" for field in fields)
    output = tm(*args, "-F", fmt)
    return [line.split("\t") for line in output.splitlines() if line]

def current():
    if not os.getenv("TMUX"):
        raise ValueError("Specify a session name outside tmux")
    return tm("display-message", "-p", "#{session_name}")

def path(name):
    return DIR / (quote(name, safe="") + ".json")

def exists(name):
    return subprocess.run(["tmux", "has-session", "-t", name], capture_output=True).returncode == 0

def foreground_process(pane_pid, command):
    """Linux: argv of the terminal foreground process-group leader, if readable."""
    try:
        stat = Path(f"/proc/{pane_pid}/stat").read_text()
        fields = stat[stat.rfind(")") + 2:].split()
        session, tty, foreground = int(fields[3]), int(fields[4]), int(fields[5])
        if tty == 0 or foreground <= 0:
            return None
        candidates = []
        for entry in Path("/proc").iterdir():
            if not entry.name.isdecimal():
                continue
            try:
                parts = (entry / "stat").read_text().split(") ", 1)[1].split()
                if (int(parts[2]), int(parts[3]), int(parts[4])) == (foreground, session, tty):
                    candidates.append(int(entry.name))
            except (OSError, ValueError, IndexError):
                continue
        for pid in sorted(candidates, key=lambda p: (p != foreground, p)):
            try:
                selected_pid = pane_pid if pid == os.getpid() else pid
                raw = Path(f"/proc/{selected_pid}/cmdline").read_bytes()
                argv = [arg.decode("utf-8", "replace") for arg in raw.rstrip(b"\0").split(b"\0")]
                if argv and argv[0]:
                    if selected_pid == pane_pid:
                        command = Path(argv[0].lstrip("-")).name
                    return {"command": command, "argv": argv}
            except OSError:
                continue
    except (OSError, ValueError, IndexError):
        pass
    return {"command": command, "argv": None}


def snapshot(name):
    sid = tm("display-message", "-p", "-t", name, "#{session_id}")
    windows = []
    for wid, idx, title, layout, active, width, height in records(
        "list-windows", "-t", sid,
        fields=("window_id", "window_index", "window_name", "window_layout",
                "window_active", "window_width", "window_height")
    ):
        panes = [{"index": int(idx), "cwd": cwd, "active": active == "1",
                  **foreground_process(int(pid), command)}
                 for idx, cwd, active, command, pid in records(
                     "list-panes", "-t", wid,
                     fields=("pane_index", "pane_current_path", "pane_active",
                             "pane_current_command", "pane_pid"))]
        if not panes:
            raise ValueError("Window has no panes")
        windows.append({"index": int(idx), "name": title, "layout": layout,
                        "active": active == "1", "width": int(width),
                        "height": int(height), "panes": panes})
    if not windows:
        raise ValueError("Session has no windows")
    return {"version": 1, "session": name,
            "saved_at": datetime.now(timezone.utc).isoformat(), "windows": windows}

def save(name):
    data = snapshot(name)
    DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".tsave-", dir=DIR)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            json.dump(data, out, ensure_ascii=False, indent=2)
            out.write("\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temporary, path(name))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Saved session {name}: {len(data['windows'])} windows -> {path(name)}")

def load(name):
    data = json.loads(path(name).read_text(encoding="utf-8"))
    if data.get("version") != 1 or data.get("session") != name:
        raise ValueError("Invalid snapshot identity/version")
    windows = data.get("windows")
    if not isinstance(windows, list) or not 1 <= len(windows) <= 200:
        raise ValueError("Invalid window list")
    indices = []
    for window in windows:
        index = window.get("index")
        if not isinstance(index, int) or not 0 <= index <= 10000:
            raise ValueError("Invalid window index")
        indices.append(index)
        if not isinstance(window.get("name"), str) or not isinstance(window.get("layout"), str):
            raise ValueError("Invalid window metadata")
        panes = window.get("panes")
        if not isinstance(panes, list) or not 1 <= len(panes) <= 100:
            raise ValueError("Invalid pane list")
        if any(not isinstance(p.get("cwd"), str) or not p["cwd"] for p in panes):
            raise ValueError("Invalid pane directory")
    if len(indices) != len(set(indices)):
        raise ValueError("Duplicate window index")
    return data

def info(name):
    data = load(name)
    print(f"Saved session {name} ({data['saved_at']})")
    for window in sorted(data["windows"], key=lambda w: w["index"]):
        print(f"Window {window['index']}: {window['name']}")
        for pane in window["panes"]:
            print(f"  Pane {pane['index']}: {pane.get('command') or 'unknown'}  {pane['cwd']}")
            if pane.get("argv"):
                print(f"    argv: {json.dumps(pane['argv'], ensure_ascii=False)}")


def apply(name):
    data = load(name)
    windows = sorted(data["windows"], key=lambda w: w["index"])
    stage = f"__tload_{os.getpid()}"
    previous = f"__tload_old_{os.getpid()}"
    old_id = tm("display-message", "-p", "-t", name, "#{session_id}") if exists(name) else None
    clients = [r[0] for r in records("list-clients", "-t", old_id, fields=("client_tty",))] if old_id else []
    staged = False
    try:
        first = windows[0]
        cwd = first["panes"][0]["cwd"]
        if not Path(cwd).is_dir():
            raise ValueError(f"Missing working directory: {cwd}")
        tm("new-session", "-d", "-s", stage, "-n", first["name"],
           "-c", cwd, "-x", first["width"], "-y", first["height"])
        staged = True
        tm("set-option", "-t", stage, "renumber-windows", "off")
        for count, window in enumerate(windows):
            if count == 0:
                wid = tm("display-message", "-p", "-t", stage, "#{window_id}")
                if window["index"] != 1:
                    tm("move-window", "-s", wid, "-t", f"{stage}:{window['index']}")
            else:
                cwd = window["panes"][0]["cwd"]
                if not Path(cwd).is_dir():
                    raise ValueError(f"Missing working directory: {cwd}")
                tm("new-window", "-d", "-t", f"{stage}:{window['index']}",
                   "-n", window["name"], "-c", cwd)
                wid = tm("display-message", "-p", "-t",
                         f"{stage}:{window['index']}", "#{window_id}")
            tm("set-option", "-w", "-t", wid, "automatic-rename", "off")
            # Pane indexes change as splits are inserted and layouts are applied.
            # Track stable pane IDs so each saved cwd ends up at its saved position.
            original_id = tm("display-message", "-p", "-t", wid, "#{pane_id}")
            pane_ids = {window["panes"][0]["index"]: original_id}
            for pane in window["panes"][1:]:
                cwd = pane["cwd"]
                if not Path(cwd).is_dir():
                    raise ValueError(f"Missing working directory: {cwd}")
                pane_ids[pane["index"]] = tm(
                    "split-window", "-d", "-h", "-P", "-F", "#{pane_id}",
                    "-t", wid, "-c", cwd)
            tm("select-layout", "-t", wid, window["layout"])
            for pane in window["panes"]:
                index = pane["index"]
                actual = dict((int(i), pid) for i, pid in records(
                    "list-panes", "-t", wid, fields=("pane_index", "pane_id")))
                desired_id = pane_ids[index]
                if actual.get(index) != desired_id:
                    tm("swap-pane", "-d", "-s", desired_id, "-t", actual[index])
            tm("rename-window", "-t", wid, window["name"])
            active_panes = [p for p in window["panes"] if p.get("active")]
            if active_panes:
                tm("select-pane", "-t", f"{wid}.{active_panes[0]['index']}")
        # Relaunch only allowlisted interactive commands, never saved arguments.
        # Vim/Neovim may restore project sessions; AI CLIs start fresh.
        for window in windows:
            target = f"{stage}:{window['index']}"
            wid = tm("display-message", "-p", "-t", target, "#{window_id}")
            for pane in window["panes"]:
                command = pane.get("command")
                if command in RESTORABLE_COMMANDS:
                    tm("send-keys", "-t", f"{wid}.{pane['index']}", "-l", command)
                    tm("send-keys", "-t", f"{wid}.{pane['index']}", "Enter")
        selected = [w for w in windows if w.get("active")]
        if selected:
            tm("select-window", "-t", f"{stage}:{selected[0]['index']}")
        if old_id:
            if tm("display-message", "-p", "-t", old_id, "#{session_name}") != name:
                raise RuntimeError("Session name changed during restoration")
            tm("rename-session", "-t", old_id, previous)
        try:
            tm("rename-session", "-t", stage, name)
        except Exception:
            if old_id:
                tm("rename-session", "-t", old_id, name)
            raise
        staged = False
        for tty in clients:
            tm("switch-client", "-c", tty, "-t", name)
        if old_id:
            tm("kill-session", "-t", old_id)
        tm("set-option", "-u", "-t", name, "renumber-windows")
    finally:
        if staged and exists(stage):
            tm("kill-session", "-t", stage)

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("action", choices=["save", "restore", "apply", "info"])
    p.add_argument("session", nargs="?", help="defaults to current session")
    p.add_argument("-y", "--yes", action="store_true", help="skip confirmation")
    args = p.parse_args()
    name = args.session or current()
    if args.action == "save":
        save(name)
        return
    data = load(name)
    if args.action == "info":
        info(name)
        return
    if args.action == "apply":
        apply(name)
        return
    print(f"Restore session {name} saved {data['saved_at']} ({len(data['windows'])} windows)?")
    if exists(name):
        print("WARNING: Existing panes, processes, and unsaved changes will be destroyed.")
    if any(pane.get("command") in RESTORABLE_COMMANDS for w in data["windows"] for pane in w["panes"]):
        print("Allowlisted interactive commands will be relaunched without saved arguments.")
        print("Vim/Neovim may restore project sessions; AI CLI sessions will start fresh.")
    if not args.yes and input("Continue? [y/N] ").strip().lower() != "y":
        print("Cancelled.")
        return
    with (DIR / "restore.log").open("a", encoding="utf-8") as log:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "apply", name],
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True)
    print(f"Restoring {name}; errors: {DIR / 'restore.log'}")

if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, OSError, KeyboardInterrupt) as error:
        print(f"tmux-session: {error}", file=sys.stderr)
        sys.exit(1)
