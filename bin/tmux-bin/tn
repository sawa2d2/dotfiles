#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || [[ ${1:-} == -* ]]; then
  echo 'Usage: tn [session]' >&2
  exit 2
fi

if [[ -n ${TMUX:-} ]]; then
  # Create detached to avoid nesting tmux, then switch the current client.
  if (($# == 1)); then
    session_id=$(tmux new-session -d -P -F '#{session_id}' -s "$1")
  else
    session_id=$(tmux new-session -d -P -F '#{session_id}')
  fi
  tmux switch-client -t "$session_id"
else
  if (($# == 1)); then
    exec tmux new-session -s "$1"
  else
    exec tmux new-session
  fi
fi
