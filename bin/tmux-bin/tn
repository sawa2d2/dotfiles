#!/usr/bin/env bash
set -euo pipefail

if (($# > 1)) || [[ ${1:-} == -* ]]; then
  echo 'Usage: tn [session]' >&2
  exit 2
fi

args=()
if (($# == 1)); then
  args=(-s "$1")
fi

if [[ -n ${TMUX:-} ]]; then
  # Create detached to avoid nesting tmux, then switch the current client.
  session_id=$(tmux new-session -d -P -F '#{session_id}' "${args[@]}")
  tmux switch-client -t "$session_id"
else
  exec tmux new-session "${args[@]}"
fi
