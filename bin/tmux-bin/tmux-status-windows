#!/usr/bin/env bash
# Render up to five rows of a tmux window list.
set -euo pipefail

# Optional timing trace, without window names or command arguments.
if [[ -n ${TMUX_STATUS_TRACE_FILE:-} ]]; then
  _trace_event() {
    local stamp
    stamp=$(perl -MTime::HiRes=time -e 'printf "%.6f", time')
    printf '%s pid=%s parent=%s event=%s\n' "$stamp" "$$" "$PPID" "$1" >> "$TMUX_STATUS_TRACE_FILE"
  }
else
  _trace_event() { :; }
fi

# Refresh session-level status heights when windows or clients change.
if [[ ${1:-} == --sync && $# == 1 ]]; then
  # Aggregate client widths with awk to support macOS's default Bash 3.2.
  # For shared sessions, use the narrowest attached client's width.
  _trace_event sync_start
  while IFS=$'\t' read -r session width; do
    _trace_event client_begin
    [[ -n $session && $width =~ ^[0-9]+$ ]] || continue
    _trace_event rows_call_begin
    # Redirect the child's stdout to a regular file: command substitution
    # can wait for EOF from unrelated descendants that inherited its pipe.
    rows_file=$(mktemp "${TMPDIR:-/tmp}/tmux-status-rows.XXXXXXXX") || exit 1
    if ! "$0" --rows "$session" "$width" > "$rows_file"; then
      rm -f "$rows_file"
      continue
    fi
    IFS= read -r rows < "$rows_file" || rows=
    rm -f "$rows_file"
    [[ $rows =~ ^[1-5]$ ]] || continue
    _trace_event rows_call_end
    _trace_event status_read_begin
    current=$(tmux show-options -v -t "$session" status 2> /dev/null) || continue
    _trace_event status_read_end
    # Store rendered rows synchronously; tmux status #() is asynchronous
    # and may not have a usable result when the status is redrawn.
    for row in 0 1 2 3 4; do
      _trace_event "render_begin_$row"
      rendered=$("$0" "$row" "$session" "$width" 2> /dev/null) || break
      _trace_event "render_end_$row"
      _trace_event "set_begin_$row"
      tmux set-option -t "$session" "@tmux_window_row$row" "$rendered" 2> /dev/null ||
        {
          tmux has-session -t "$session" 2> /dev/null && exit 1
          break
        }
    done
    _trace_event client_rows_done
    target=$rows
    [[ $rows == 1 ]] && target=on
    if [[ $current != "$target" ]]; then
      tmux set-option -t "$session" status "$target" 2> /dev/null ||
        {
          tmux has-session -t "$session" 2> /dev/null && exit 1
          continue
        }
    fi
    _trace_event client_end
  done < <(
    tmux list-clients -F '#{session_id}	#{client_width}' |
      awk -F '\t' '$2 ~ /^[0-9]+$/ && $1 != "" {
                if (!($1 in widths) || $2 < widths[$1]) widths[$1] = $2
            } END {
                for (session in widths) print session "\t" widths[session]
            }'
  )
  _trace_event sync_end
  exit 0
fi

if (($# != 3)) || [[ $1 != 0 && $1 != 1 && $1 != 2 && $1 != 3 && $1 != 4 && $1 != --rows ]] || [[ ! $3 =~ ^[0-9]+$ ]]; then
  printf 'Usage: tmux-status-windows <0|1|2|3|4|--rows> <session-id> <width>\n' >&2
  exit 2
fi

requested_row=$1
session_id=$2
width=$3

# Reserve space for the prefix indicator and date/time on row zero.
first_width=$((width > 34 ? width - 34 : 1))
other_width=$((width > 3 ? width - 3 : 1))

if [[ $requested_row == --rows ]]; then
  _trace_event rows_start
  row=0
  used=0
  while IFS= read -r label; do
    [[ -n $label ]] || continue
    length=$((${#label} + 2))
    ((used > 0)) && length=$((length + 1))
    limit=$((row == 0 ? first_width : other_width))
    if ((used > 0 && used + length > limit)); then
      row=$((row + 1))
      used=0
      length=$((${#label} + 2))
    fi
    used=$((used + length))
  done < <(tmux list-windows -t "$session_id" -F '#{window_index}:#{window_name}')
  _trace_event rows_list_done
  ((row > 4)) && row=4
  _trace_event rows_before_print
  printf '%s\n' "$((row + 1))"
  _trace_event sync_end
  exit 0
fi

_trace_event render_start
# Query the theme once; use tmux format expansion to resolve custom colors.
IFS=$'\t' read -r active_fg active_bg inactive_fg inactive_bg bar_bg <<< "$(
  tmux display-message -p -t "$session_id" '#{@color_white}	#{@color_active}	#{@color_fg}	#{@color_inactive}	#{@color_bg}'
)"
active_fg=${active_fg:-white}
active_bg=${active_bg:-black}
inactive_fg=${inactive_fg:-black}
inactive_bg=${inactive_bg:-white}
bar_bg=${bar_bg:-default}

row=0
used=0
while IFS=$'\t' read -r label active; do
  [[ -n $label ]] || continue
  entry=" $label "
  length=${#entry}
  ((used > 0)) && length=$((length + 1))
  limit=$((row == 0 ? first_width : other_width))

  if ((used > 0 && used + length > limit)); then
    row=$((row + 1))
    used=0
    length=${#entry}
  fi
  ((row > 4)) && break

  if ((row == requested_row)); then
    if ((used > 0)); then
      printf '#[bg=%s] ' "$bar_bg"
    fi
    if [[ $active == 1 ]]; then
      printf '#[fg=%s,bg=%s,bold]%s' "$active_fg" "$active_bg" "$entry"
    else
      printf '#[fg=%s,bg=%s,nobold]%s' "$inactive_fg" "$inactive_bg" "$entry"
    fi
  fi
  used=$((used + length))
done < <(tmux list-windows -t "$session_id" -F '#{window_index}:#{window_name}	#{window_active}')

printf '#[default]'
_trace_event render_end
