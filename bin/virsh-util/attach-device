#!/bin/bash
set -ueC

SHARED_DIR="${SHARED_DIR:-/mnt/ext/shared}"
MOUNT_TAG="${MOUNT_TAG:-shared}"
GUEST_MOUNTPOINT="${GUEST_MOUNTPOINT:-/mnt/shared}"

usage() {
  echo "Usage: $0 <domain1> [domain2 ...]"
  echo "Optional:"
  echo "  SHARED_DIR=/path/to/shared MOUNT_TAG=shared GUEST_MOUNTPOINT=/mnt/shared $0 <domain1> [domain2 ...]"
}

if [ $# -eq 0 ]; then
  usage
  exit 1
fi

for domain in "$@"; do
  virsh attach-device "$domain" /dev/stdin --live --config <<EOF
<filesystem type="mount" accessmode="passthrough">
  <driver type="virtiofs" queue="1024"/>
  <source dir="${SHARED_DIR}"/>
  <target dir="${MOUNT_TAG}"/>
</filesystem>
EOF
done

echo "Run the following command on the guest:"
echo "  sudo mkdir -p ${GUEST_MOUNTPOINT} && sudo mount -t virtiofs ${MOUNT_TAG} ${GUEST_MOUNTPOINT}"
