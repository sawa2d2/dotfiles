#!/usr/bin/env bash
# Remove only local branches whose changes can be proven present on origin/main.
set -euo pipefail

usage() {
  printf 'Usage: gprune [-q|--quiet] [-w|--worktrees]\n' >&2
  printf 'Quiet: skip repositories without origin/main and print only deletions.\n' >&2
  printf 'Worktrees: also remove clean linked worktrees of deletable branches.\n' >&2
}

quiet=false
worktrees=false
for arg in "$@"; do
  case $arg in
  -q | --quiet) quiet=true ;;
  -w | --worktrees) worktrees=true ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
  esac
done

git rev-parse --is-inside-work-tree > /dev/null
# Quiet mode runs automatically after fetch/pull, so skip unsupported repositories.
if $quiet && ! git show-ref --verify --quiet refs/remotes/origin/main; then
  exit 0
fi
fetch_opts=(--prune)
$quiet && fetch_opts+=(--quiet)
git fetch "${fetch_opts[@]}" origin || {
  echo 'Failed to refresh origin; no branches deleted.' >&2
  exit 1
}
git show-ref --verify --quiet refs/remotes/origin/main || {
  echo 'origin/main not found; no branches deleted.' >&2
  exit 1
}

# Forget worktrees whose directories were deleted manually.
if $worktrees; then git worktree prune; fi
# One "branch<TAB>path" line per worktree; branch names cannot contain tabs.
checked_out=$(git worktree list --porcelain |
  awk '/^worktree /{path=substr($0,10)} /^branch refs\/heads\//{print substr($0,19) "\t" path}')
primary=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
current=$(git rev-parse --show-toplevel)
deleted=0
while IFS= read -r branch; do
  case $branch in
  main | master | develop | development) continue ;;
  esac
  worktree=$(printf '%s\n' "$checked_out" | awk -F '\t' -v b="$branch" '$1 == b {print $2; exit}')
  if [[ -n $worktree ]]; then
    # Only -w may remove a worktree, and never the primary or current one.
    $worktrees && [[ $worktree != "$primary" && $worktree != "$current" ]] || continue
  fi
  # Never delete a local branch that still exists on origin.
  if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    continue
  fi

  if git merge-base --is-ancestor "$branch" origin/main; then
    reason='merged'
  else
    base=$(git merge-base origin/main "$branch") || continue
    # git cherry compares patch IDs; merge commits have no comparable patch.
    # Refuse branches with merges or with any unmatched local commit.
    if [[ -n $(git rev-list --merges "$base..$branch") ]]; then
      continue
    fi
    cherries=$(git cherry origin/main "$branch" "$base") || continue
    if [[ -n $cherries && $cherries != *'+'* ]]; then
      reason='patch-equivalent'
    else
      # Also recognize a multi-commit branch squashed into one main commit.
      # Matching patch IDs prove the aggregate diff was applied verbatim.
      patch=$(git diff --no-ext-diff "$base" "$branch" | git patch-id --stable) || continue
      patch=${patch%% *}
      [[ -n $patch ]] || continue
      if ! git log -p --no-merges --no-ext-diff --format='commit %H' "$base..origin/main" |
        git patch-id --stable | grep -q "^$patch "; then
        continue
      fi
      reason='squash-equivalent'
    fi
  fi

  if [[ -n $worktree ]]; then
    # Without --force, git refuses worktrees with changes, untracked files or a lock.
    if ! git worktree remove "$worktree"; then
      printf 'SKIP %-47s (worktree not removable: %s)\n' "$branch" "$worktree"
      continue
    fi
    reason="$reason, worktree $worktree"
  fi
  printf 'DELETE %-45s (%s)\n' "$branch" "$reason"
  git branch -D -- "$branch" > /dev/null
  deleted=$((deleted + 1))
done < <(git for-each-ref --format='%(refname:short)' refs/heads)

$quiet || printf 'Deleted %d local branch(es).\n' "$deleted"
