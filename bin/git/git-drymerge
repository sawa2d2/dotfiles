#!/usr/bin/env bash
set -euo pipefail

target="${1:-main}"

if [[ $# -gt 1 ]]; then
  echo "Usage: git-drymerge [target-branch]" >&2
  exit 2
fi

if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  echo "Not inside a Git repository." >&2
  exit 2
fi

# Fetch target branch without modifying the worktree.
echo "Fetching origin/$target..."
git fetch --quiet origin "$target"

# Test merge without modifying the index or worktree.
echo "Testing merge: HEAD <- origin/$target"

if result=$(git merge-tree --write-tree HEAD FETCH_HEAD); then
  echo "No conflicts detected."
  exit 0
else
  status=$?
fi

if [[ $status -eq 1 ]]; then
  echo "Conflicts detected:"
  printf '%s\n' "$result"
  exit 1
fi

echo "Merge simulation failed (exit $status)." >&2
exit 2
