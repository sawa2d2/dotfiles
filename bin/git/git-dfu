#!/usr/bin/env bash
# Show unstaged tracked changes and untracked file contents without staging.
set -o pipefail

git_options=()
diff_options=()
if [[ ${1-} == -p ]]; then
  shift
  git_options=(--no-pager)
  diff_options=(--no-color --no-ext-diff)
fi

if (($# != 0)); then
  printf 'Usage: git dfu [-p]\n' >&2
  exit 2
fi

git "${git_options[@]}" diff "${diff_options[@]}" || exit $?

while IFS= read -r -d '' file; do
  git "${git_options[@]}" diff "${diff_options[@]}" --no-index -- /dev/null "$file"
  status=$?
  # --no-index returns 1 when files differ; anything higher is an error.
  if ((status > 1)); then
    exit "$status"
  fi
done < <(git ls-files --others --exclude-standard -z)
