#!/usr/bin/env bash
# Open the current branch's compare page, which links to its open PR if any;
# on the default branch, open the repository's top page. Uses only git, not the
# GitHub API, and never pushes.
set -euo pipefail

if (($# != 0)); then
  echo 'Usage: ghpr' >&2
  exit 2
fi

branch=$(git symbolic-ref --quiet --short HEAD) || {
  echo "Not on a branch." >&2
  exit 1
}

# Open browser without forwarding its output to the terminal.
open_url() {
  case "$(uname -s)" in
  Linux)
    nohup xdg-open "$1" > /dev/null 2>&1 < /dev/null &
    ;;
  Darwin)
    open "$1" > /dev/null 2>&1
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
  esac
}

# Percent-encode a branch name for a URL path; / stays as the separator.
urlencode() {
  local LC_ALL=C s=$1 out='' c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
    [A-Za-z0-9._~/-]) out+=$c ;;
    *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s\n' "$out"
}

# Normalize the origin URL (https, scp-like or ssh://) to https://<host>/<owner>/<repo>.
url=$(git remote get-url origin)
url=${url%.git}
case $url in
https://*) repo_url=$url ;;
ssh://*)
  url=${url#ssh://}
  repo_url=https://${url#*@}
  ;;
*@*:*)
  url=${url#*@}
  repo_url=https://${url%%:*}/${url#*:}
  ;;
*)
  echo "Unsupported remote URL: $url" >&2
  exit 1
  ;;
esac

default_branch=$(git ls-remote --symref origin HEAD |
  awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2 }')
if [[ -z $default_branch ]]; then
  echo "Default branch not found on origin." >&2
  exit 1
fi
if [[ $branch == "$default_branch" ]]; then
  open_url "$repo_url"
  exit
fi

if ! git ls-remote --exit-code --heads origin "refs/heads/$branch" > /dev/null; then
  echo "Remote branch not found: $branch (push it first)" >&2
  exit 1
fi
open_url "$repo_url/compare/$(urlencode "$default_branch")...$(urlencode "$branch")?expand=1"
