#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'Usage: gfinish [-y|--yes] [-m <message> | -- <message...>]' >&2
}

assume_yes=false
message=
message_given=false
while (($#)); do
  case $1 in
  -y | --yes)
    assume_yes=true
    shift
    ;;
  -m)
    if (($# < 2)) || [[ -z $2 ]]; then
      usage
      exit 2
    fi
    message=$2
    message_given=true
    shift 2
    ;;
  --)
    if $message_given || (($# < 2)); then
      usage
      exit 2
    fi
    shift
    message="$*"
    if [[ -z ${message//[[:space:]]/} ]]; then
      usage
      exit 2
    fi
    message_given=true
    break
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
  esac
done

confirm() {
  if $assume_yes; then return 0; fi
  local answer
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY] ]]
}

# Write the squash commit message to $1, letting the user edit it unless one
# was given or -y was passed. An empty message or a failed editor fails.
write_squash_message() {
  local file=$1 editor
  if $message_given || $assume_yes; then
    printf '%s\n' "$message" > "$file"
    return
  fi
  printf '%s\n\n# Squash of %s into main. Lines starting with # are ignored;\n# an empty message aborts.\n' \
    "$message" "$feature" > "$file"
  # GIT_EDITOR may hold arguments (e.g. "code --wait"); let the shell split it.
  editor=$(git var GIT_EDITOR)
  eval "$editor \"\$file\"" || return
  git stripspace --strip-comments < "$file" > "$file.clean"
  mv -- "$file.clean" "$file"
  [[ -s $file ]]
}

feature=$(git symbolic-ref --quiet --short HEAD) || {
  echo "Not on a branch." >&2
  exit 1
}
if ! $message_given; then
  prefix=${feature%%/*}
  description=${feature#*/}
  if [[ $description == "$feature" ]]; then
    message=${feature//-/ }
  else
    case $prefix in
    feat | feature) prefix=feat ;;
    fix | bugfix) prefix=fix ;;
    docs | doc) prefix=docs ;;
    chore | refactor | test | perf | ci | build | style) ;;
    *) prefix=chore ;;
    esac
    message="$prefix: ${description//-/ }"
  fi
fi

if [[ $feature == main ]]; then
  echo "Run gfinish from a feature branch." >&2
  exit 1
fi
if [[ -n $(git status --porcelain) ]]; then
  echo "Commit or stash changes before running gfinish." >&2
  exit 1
fi

git fetch origin main
# Auto-push only when the feature branch is strictly ahead of its remote.
# Never force-push, and stop if the remote is ahead or has diverged.
remote_feature=$(git ls-remote --heads origin "refs/heads/$feature") || {
  echo "Could not check origin/$feature." >&2
  exit 1
}
if [[ -n $remote_feature ]]; then
  remote_sha=${remote_feature%%[[:space:]]*}
  local_sha=$(git rev-parse HEAD)
  if [[ $local_sha != "$remote_sha" ]]; then
    # Fetch the exact remote tip so the ancestry check is reliable even
    # when the remote-tracking ref is stale.
    git fetch origin "refs/heads/$feature"
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "Local $feature is behind or diverged from origin/$feature; synchronize it first." >&2
      exit 1
    fi
    echo "Local $feature is ahead of origin/$feature; pushing."
    git push origin "HEAD:refs/heads/$feature" || {
      echo "Could not push $feature; stopping." >&2
      exit 1
    }
    pushed_sha=$(git ls-remote --heads origin "refs/heads/$feature")
    if [[ ${pushed_sha%%[[:space:]]*} != "$local_sha" ]]; then
      echo "origin/$feature changed after push; stopping." >&2
      exit 1
    fi
  fi
fi
# Fast-forward local main when it only trails origin/main.
# Never discard local commits or update a dirty checked-out main worktree.
primary=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
current=$(git rev-parse --show-toplevel)
main_worktree=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10) }
  /^branch refs\/heads\/main$/ { print path; exit }
')
if [[ $(git rev-parse main) != $(git rev-parse origin/main) ]]; then
  if ! git merge-base --is-ancestor main origin/main; then
    echo "Local main has commits not on origin/main; synchronize it manually." >&2
    exit 1
  fi
  if [[ -n $main_worktree ]]; then
    if [[ -n $(git -C "$main_worktree" status --porcelain) ]]; then
      echo "Main worktree has uncommitted changes: $main_worktree" >&2
      exit 1
    fi
    git -C "$main_worktree" merge --ff-only origin/main
  else
    git branch -f main origin/main
  fi
fi
if git diff --quiet main "$feature"; then
  echo "No changes to integrate." >&2
  exit 1
fi

# main may be checked out in any worktree, or in none. The squash is built
# from trees alone, so no checkout (or checkout filter such as Git LFS) runs
# until main is advanced.
if [[ -n $main_worktree && -n $(git -C "$main_worktree" status --porcelain) ]]; then
  echo "Main worktree has uncommitted changes: $main_worktree" >&2
  exit 1
fi

if [[ $current == "$primary" ]]; then
  echo "Squash $feature into main, then push and remove the local branch."
else
  echo "Squash $feature into main, push, and remove its worktree."
fi
git diff --stat main "$feature"
confirm "Continue?" || exit 0

old_main=$(git rev-parse main)
if ! merged=$(git merge-tree --write-tree --name-only "$old_main" "$feature"); then
  echo "Squash of $feature into main conflicts; merge main into $feature first:" >&2
  # After the tree ID: conflicted paths, a blank line, then merge messages.
  sed -n '2,/^$/p' <<< "$merged" | sed '/^$/d; s/^/  /' >&2
  exit 1
fi
message_file=$(mktemp)
trap 'rm -f -- "$message_file"' EXIT
if ! write_squash_message "$message_file"; then
  echo "Squash commit was not made; main is unchanged." >&2
  exit 1
fi
result=$(git commit-tree "${merged%%$'\n'*}" -p "$old_main" -F "$message_file")

# Advance main where it lives: fast-forward its worktree, or move the ref
# (only if it still points where it did) when nothing has it checked out.
if [[ -n $main_worktree ]]; then
  git -C "$main_worktree" merge --ff-only "$result"
else
  git update-ref refs/heads/main "$result" "$old_main"
fi
git push origin main

if [[ $current == "$primary" ]]; then
  # A branch can be checked out in one worktree only.
  if [[ -n $main_worktree ]]; then
    git switch -q --detach main
    echo "main is checked out in $main_worktree; left $current detached at main."
  else
    git switch -q main
  fi
else
  # Move the helper process away before deleting its current worktree.
  cd -- "$primary"
  # Do not force-remove: if the feature worktree acquired changes, preserve them.
  git worktree remove "$current"
fi
git branch -D "$feature"

if git ls-remote --exit-code --heads origin "$feature" > /dev/null 2>&1; then
  if confirm "Delete remote branch origin/$feature?"; then
    git push origin --delete "$feature"
  fi
fi

echo "Finished: $feature -> main"
