#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'Usage: gfinish [-y|--yes] [-m <message>]' >&2
}

assume_yes=false
message=
message_given=false
while (($#)); do
  case $1 in
    -y|--yes) assume_yes=true; shift ;;
    -m)
      if (($# < 2)) || [[ -z $2 ]]; then
        usage
        exit 2
      fi
      message=$2
      message_given=true
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

confirm() {
  if $assume_yes; then return 0; fi
  local answer
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY] ]]
}

commit_squash() {
  local worktree=$1
  if $message_given || $assume_yes; then
    git -C "$worktree" commit -m "$message"
  else
    git -C "$worktree" commit -e -m "$message"
  fi
}

feature=$(git symbolic-ref --quiet --short HEAD) || {
	echo "Not on a branch." >&2
	exit 1
}
if ! $message_given; then
  prefix=${feature%%/*}
  description=${feature#*/}
  if [[ $description == "$feature" ]]; then
    message=${feature//-/ }
  else
    case $prefix in
      feat|feature) prefix=feat ;;
      fix|bugfix) prefix=fix ;;
      docs|doc) prefix=docs ;;
      chore|refactor|test|perf|ci|build|style) ;;
      *) prefix=chore ;;
    esac
    message="$prefix: ${description//-/ }"
  fi
fi

if [[ $feature == main ]]; then
	echo "Run gfinish from a feature branch." >&2
	exit 1
fi
if [[ -n $(git status --porcelain) ]]; then
	echo "Commit or stash changes before running gfinish." >&2
	exit 1
fi

git fetch origin main
# Refuse to integrate a feature branch whose remote history differs.
remote_feature=$(git ls-remote --heads origin "refs/heads/$feature") || {
  echo "Could not check origin/$feature." >&2
  exit 1
}
if [[ -n $remote_feature ]]; then
  remote_sha=${remote_feature%%[[:space:]]*}
  if [[ $(git rev-parse "$feature") != "$remote_sha" ]]; then
    echo "Local $feature differs from origin/$feature; synchronize it first." >&2
    exit 1
  fi
fi
# Fast-forward local main when it only trails origin/main.
# Never discard local commits or update a dirty checked-out main worktree.
primary=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
current=$(git rev-parse --show-toplevel)
main_worktree=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10) }
  /^branch refs\/heads\/main$/ { print path; exit }
')
if [[ $(git rev-parse main) != $(git rev-parse origin/main) ]]; then
  if ! git merge-base --is-ancestor main origin/main; then
    echo "Local main has commits not on origin/main; synchronize it manually." >&2
    exit 1
  fi
  if [[ -n $main_worktree ]]; then
    if [[ -n $(git -C "$main_worktree" status --porcelain) ]]; then
      echo "Main worktree has uncommitted changes: $main_worktree" >&2
      exit 1
    fi
    git -C "$main_worktree" merge --ff-only origin/main
  else
    git branch -f main origin/main
  fi
fi
if git diff --quiet main "$feature"; then
	echo "No changes to integrate." >&2
	exit 1
fi

# When running inside an additional worktree, integrate through the primary main worktree.
if [[ $current != "$primary" ]]; then
  if [[ $(git -C "$primary" symbolic-ref --quiet --short HEAD || true) != main ]]; then
    echo "The primary worktree must be on main: $primary" >&2
    exit 1
  fi
  if [[ -n $(git -C "$primary" status --porcelain) ]]; then
    echo "The primary main worktree must be clean: $primary" >&2
    exit 1
  fi

  echo "Squash $feature into main, push, and remove its worktree."
  git diff --stat main "$feature"
  confirm "Continue?" || exit 0

  # A detached temporary worktree keeps main unchanged until the squash commit succeeds.
  temporary=$(mktemp -d)
  rmdir "$temporary"
  git worktree add --detach "$temporary" main
  if ! git -C "$temporary" merge --squash "$feature"; then
    echo "Squash failed in $temporary. Resolve or remove that worktree manually." >&2
    exit 1
  fi
  commit_squash "$temporary"
  result=$(git -C "$temporary" rev-parse HEAD)
  git -C "$primary" merge --ff-only "$result"
  git push origin main
  git worktree remove "$temporary"

  # Move the helper process away before deleting its current worktree.
  cd -- "$primary"
  # Do not force-remove: if the feature worktree acquired changes, preserve them.
  git worktree remove "$current"
  git branch -D "$feature"
  if git ls-remote --exit-code --heads origin "$feature" >/dev/null 2>&1; then
    if confirm "Delete remote branch origin/$feature?"; then
      git push origin --delete "$feature"
    fi
  fi
  echo "Finished: $feature -> main"
  exit 0
fi

echo "Squash $feature into main, then push and remove the local branch."
git diff --stat main "$feature"
confirm "Continue?" || exit 0

# Keep the original feature history intact, including when it has been pushed.
temporary="gfinish-$$"
git switch -c "$temporary" main
if ! git merge --squash "$feature"; then
	echo "Squash failed on $temporary. Resolve or abort before retrying." >&2
	exit 1
fi
commit_squash .

git switch main
git merge --ff-only "$temporary"
git push origin main

git branch -d "$temporary"
git branch -D "$feature"

if git ls-remote --exit-code --heads origin "$feature" >/dev/null 2>&1; then
	if confirm "Delete remote branch origin/$feature?"; then
		git push origin --delete "$feature"
	fi
fi

echo "Finished: $feature -> main"
