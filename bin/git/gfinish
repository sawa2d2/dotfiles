#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'Usage: gfinish [-y|--yes] [--offline] [-m <message> | -- <message...>]' >&2
  echo '  --offline  squash into the cached origin default branch locally; push nothing' >&2
}

assume_yes=false
offline=false
message=
message_given=false
while (($#)); do
  case $1 in
  -y | --yes)
    assume_yes=true
    shift
    ;;
  --offline)
    offline=true
    shift
    ;;
  -m)
    if (($# < 2)) || [[ -z $2 ]]; then
      usage
      exit 2
    fi
    message=$2
    message_given=true
    shift 2
    ;;
  --)
    if $message_given || (($# < 2)); then
      usage
      exit 2
    fi
    shift
    message="$*"
    if [[ -z ${message//[[:space:]]/} ]]; then
      usage
      exit 2
    fi
    message_given=true
    break
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
  esac
done

confirm() {
  if $assume_yes; then return 0; fi
  local answer
  read -r -p "$1 [y/N] " answer
  [[ $answer == [yY] ]]
}

# Write the squash commit message to $1, letting the user edit it unless one
# was given or -y was passed. An empty message or a failed editor fails.
write_squash_message() {
  local file=$1 editor
  if $message_given || $assume_yes; then
    printf '%s\n' "$message" > "$file"
    return
  fi
  printf '%s\n\n# Squash of %s into %s. Lines starting with # are ignored;\n# an empty message aborts.\n' \
    "$message" "$feature" "$default_branch" > "$file"
  # GIT_EDITOR may hold arguments (e.g. "code --wait"); let the shell split it.
  editor=$(git var GIT_EDITOR)
  eval "$editor \"\$file\"" || return
  git stripspace --strip-comments < "$file" > "$file.clean"
  mv -- "$file.clean" "$file"
  [[ -s $file ]]
}

feature=$(git symbolic-ref --quiet --short HEAD) || {
  echo "Not on a branch." >&2
  exit 1
}
if ! $message_given; then
  prefix=${feature%%/*}
  description=${feature#*/}
  if [[ $description == "$feature" ]]; then
    message=${feature//-/ }
  else
    case $prefix in
    feat | feature) prefix=feat ;;
    fix | bugfix) prefix=fix ;;
    docs | doc) prefix=docs ;;
    chore | refactor | test | perf | ci | build | style) ;;
    *) prefix=chore ;;
    esac
    message="$prefix: ${description//-/ }"
  fi
fi

if [[ -n $(git status --porcelain) ]]; then
  echo "Commit or stash changes before running gfinish." >&2
  exit 1
fi

# An agent (AGENT_APPROVAL_DIR is set by its launch wrapper) may finish only
# after the user's prompt was exactly "approved", which leaves a marker for
# the real top level of the session's worktree. The key is per worktree, not
# per repository, so approving in one session cannot finish a branch that
# another session works on. The marker is used up before merging.
approval_marker=
if [[ -n ${AGENT_APPROVAL_DIR:-} ]]; then
  approval_top=$(realpath -- "$(git rev-parse --show-toplevel)")
  approval_marker=$AGENT_APPROVAL_DIR/$(printf %s "$approval_top" | sha256sum | cut -c1-64)
  if [[ -z $(find "$approval_marker" -maxdepth 0 -mmin -60 2> /dev/null) ]]; then
    echo "gfinish: an agent needs the user to say approved first" >&2
    echo "gfinish: approval counts only in a session whose working directory is in $approval_top" >&2
    exit 1
  fi
fi

# Resolve origin's advertised default online; offline, use only its cached HEAD.
if $offline; then
  default_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD) || {
    echo "Could not resolve cached origin default branch (origin/HEAD)." >&2
    exit 1
  }
  default_branch=${default_ref#refs/remotes/origin/}
else
  remote_head=$(git ls-remote --symref origin HEAD) || {
    echo "Could not resolve origin default branch." >&2
    exit 1
  }
  default_branch=$(awk '$1 == "ref:" && $2 ~ /^refs\/heads\// && $3 == "HEAD" {
    sub(/^refs\/heads\//, "", $2); print $2; exit
  }' <<< "$remote_head")
fi
if [[ -z $default_branch ]] || ! git check-ref-format "refs/heads/$default_branch"; then
  echo "Could not resolve origin default branch." >&2
  exit 1
fi
if [[ $feature == "$default_branch" ]]; then
  echo "Run gfinish from a feature branch." >&2
  exit 1
fi
if ! $offline; then
  git fetch origin "refs/heads/$default_branch:refs/remotes/origin/$default_branch"
fi
for ref in "refs/heads/$default_branch" "refs/remotes/origin/$default_branch"; do
  if ! git rev-parse --verify --quiet "$ref^{commit}" > /dev/null; then
    echo "Required default branch ref is unavailable: $ref" >&2
    exit 1
  fi
done
if ! $offline; then
  # Auto-push only when the feature branch is strictly ahead of its remote.
  # Never force-push, and stop if the remote is ahead or has diverged.
  remote_feature=$(git ls-remote --heads origin "refs/heads/$feature") || {
    echo "Could not check origin/$feature." >&2
    exit 1
  }
  if [[ -n $remote_feature ]]; then
    remote_sha=${remote_feature%%[[:space:]]*}
    local_sha=$(git rev-parse HEAD)
    if [[ $local_sha != "$remote_sha" ]]; then
      # Fetch the exact remote tip so the ancestry check is reliable even
      # when the remote-tracking ref is stale.
      git fetch origin "refs/heads/$feature"
      if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "Local $feature is behind or diverged from origin/$feature; synchronize it first." >&2
        exit 1
      fi
      echo "Local $feature is ahead of origin/$feature; pushing."
      git push origin "HEAD:refs/heads/$feature" || {
        echo "Could not push $feature; stopping." >&2
        exit 1
      }
      pushed_sha=$(git ls-remote --heads origin "refs/heads/$feature")
      if [[ ${pushed_sha%%[[:space:]]*} != "$local_sha" ]]; then
        echo "origin/$feature changed after push; stopping." >&2
        exit 1
      fi
    fi
  fi
fi
# Fast-forward the local default branch when it only trails origin.
# Never discard local commits or update a dirty default-branch worktree.
# Offline, keep squashes from earlier offline runs that are still unpushed.
primary=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
current=$(git rev-parse --show-toplevel)
default_worktree=$(git worktree list --porcelain | awk -v target="refs/heads/$default_branch" '
  /^worktree / { path = substr($0, 10) }
  $1 == "branch" && $2 == target { print path; exit }
')
if [[ $(git rev-parse "$default_branch") != $(git rev-parse "origin/$default_branch") ]] &&
  ! { $offline && git merge-base --is-ancestor "origin/$default_branch" "$default_branch"; }; then
  if ! git merge-base --is-ancestor "$default_branch" "origin/$default_branch"; then
    echo "Local $default_branch has commits not on origin/$default_branch; synchronize it manually." >&2
    exit 1
  fi
  if [[ -n $default_worktree ]]; then
    if [[ -n $(git -C "$default_worktree" status --porcelain) ]]; then
      echo "$default_branch worktree has uncommitted changes: $default_worktree" >&2
      exit 1
    fi
    git -C "$default_worktree" merge --ff-only "origin/$default_branch"
  else
    git branch -f "$default_branch" "origin/$default_branch"
  fi
fi
if git diff --quiet "$default_branch" "$feature"; then
  echo "No changes to integrate." >&2
  exit 1
fi

# The default branch may be checked out in any worktree, or in none. The squash is built
# from trees alone, so no checkout (or checkout filter such as Git LFS) runs
# until the default branch is advanced.
if [[ -n $default_worktree && -n $(git -C "$default_worktree" status --porcelain) ]]; then
  echo "$default_branch worktree has uncommitted changes: $default_worktree" >&2
  exit 1
fi

if [[ $current == "$primary" ]]; then
  echo "Squash $feature into $default_branch, then push and remove the local branch."
else
  echo "Squash $feature into $default_branch, push, and remove its worktree."
fi
if $offline; then
  echo "Offline: nothing is pushed to or deleted from origin."
fi
git diff --stat "$default_branch" "$feature"
confirm "Continue?" || exit 0

if [[ -n $approval_marker ]]; then
  rm -f -- "$approval_marker"
fi
old_default=$(git rev-parse "$default_branch")
if ! merged=$(git merge-tree --write-tree --name-only "$old_default" "$feature"); then
  echo "Squash of $feature into $default_branch conflicts; merge $default_branch into $feature first:" >&2
  # After the tree ID: conflicted paths, a blank line, then merge messages.
  sed -n '2,/^$/p' <<< "$merged" | sed '/^$/d; s/^/  /' >&2
  exit 1
fi
message_file=$(mktemp)
trap 'rm -f -- "$message_file"' EXIT
if ! write_squash_message "$message_file"; then
  echo "Squash commit was not made; $default_branch is unchanged." >&2
  exit 1
fi
result=$(git commit-tree "${merged%%$'\n'*}" -p "$old_default" -F "$message_file")

# Advance the default branch: fast-forward its worktree, or move the ref
# (only if it still points where it did) when nothing has it checked out.
if [[ -n $default_worktree ]]; then
  git -C "$default_worktree" merge --ff-only "$result"
else
  git update-ref "refs/heads/$default_branch" "$result" "$old_default"
fi
if ! $offline; then
  git push origin "$default_branch"
fi

if [[ $current == "$primary" ]]; then
  # A branch can be checked out in one worktree only.
  if [[ -n $default_worktree ]]; then
    git switch -q --detach "$default_branch"
    echo "$default_branch is checked out in $default_worktree; left $current detached at $default_branch."
  else
    git switch -q "$default_branch"
  fi
else
  # Move the helper process away before deleting its current worktree.
  cd -- "$primary"
  # Do not force-remove: if the feature worktree acquired changes, preserve them.
  git worktree remove "$current"
fi
# A branch renamed with `git branch -m` after it was pushed still tracks its
# old name on origin. Read the upstream and reflog before the branch (and
# its config and reflog) is deleted.
feature_sha=$(git rev-parse "refs/heads/$feature")
upstream_remote=$(git config "branch.$feature.remote" || true)
upstream_merge=$(git config "branch.$feature.merge" || true)
old_name=
if [[ $upstream_merge == refs/heads/* && ${upstream_merge#refs/heads/} != "$feature" ]] &&
  git reflog show --format=%gs "refs/heads/$feature" |
  grep -qF "Branch: renamed $upstream_merge to refs/heads/"; then
  old_name=${upstream_merge#refs/heads/}
fi
# Other local branches that track the old name share it; leave it to them.
old_name_trackers=
if [[ -n $old_name ]]; then
  old_name_trackers=$(git for-each-ref --format='%(refname:short)%09%(upstream)' refs/heads |
    awk -F '\t' -v self="$feature" -v upstream="refs/remotes/$upstream_remote/$old_name" \
      '$1 != self && $2 == upstream { print $1 }')
fi
git branch -D "$feature"

if ! $offline && git ls-remote --exit-code --heads origin "$feature" > /dev/null 2>&1; then
  if confirm "Delete remote branch origin/$feature?"; then
    git push origin --delete "$feature"
  fi
fi

# Delete the old name only when nothing on it could be lost: it is on origin,
# is not the default branch, no other branch tracks it, and its tip is in the feature.
if ! $offline && [[ -n $old_name ]]; then
  old_ref=$(git ls-remote --heads origin "refs/heads/$old_name" 2> /dev/null || true)
  old_sha=${old_ref%%[[:space:]]*}
  if [[ $upstream_remote != origin ]]; then
    echo "Kept $upstream_remote/$old_name (old name of $feature): not on origin."
  elif [[ -z $old_sha ]]; then
    :
  elif [[ $old_name == "$default_branch" ]]; then
    echo "Kept origin/$default_branch (old name of $feature): it is $default_branch."
  elif [[ -n $old_name_trackers ]]; then
    echo "Kept origin/$old_name (old name of $feature): also tracked by ${old_name_trackers//$'\n'/, }."
  elif ! git fetch -q origin "refs/heads/$old_name" ||
    ! git merge-base --is-ancestor "$old_sha" "$feature_sha"; then
    echo "Kept origin/$old_name (old name of $feature): it has commits not in $feature."
  elif confirm "Delete origin/$old_name, the old name of $feature?"; then
    # The lease refuses the delete if someone pushed to it since the check.
    git push --force-with-lease="refs/heads/$old_name:$old_sha" origin --delete "$old_name"
  fi
fi

if $offline; then
  echo "Offline: once origin is reachable, run:"
  echo "  git push origin $default_branch"
  # The cached remote-tracking ref tells whether the branch was pushed.
  if git rev-parse --verify -q "refs/remotes/origin/$feature" > /dev/null; then
    echo "  git push origin --delete $feature"
  fi
  echo "If origin/$default_branch moved meanwhile, run 'git pull --rebase origin $default_branch' on $default_branch before pushing."
fi
echo "Finished: $feature -> $default_branch"
