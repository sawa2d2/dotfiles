#!/usr/bin/env bash
set -euo pipefail

create_branch=0
delete_worktree=0
if (($# == 2)) && [[ $1 == -d ]]; then
  delete_worktree=1
  branch=$2
elif (($# == 2)) && [[ $1 == -b ]]; then
  create_branch=1
  branch=$2
elif (($# == 1)) && [[ $1 != -* ]]; then
  branch=$1
else
  echo 'Usage: gwt-path [-b|-d] <branch>' >&2
  exit 2
fi
if [[ $create_branch == 1 ]] && ! git check-ref-format --branch "$branch" > /dev/null; then
  echo "Invalid branch name: $branch" >&2
  exit 1
fi
git rev-parse --is-inside-work-tree > /dev/null

# The primary worktree is reserved for main; do not create a second main worktree.
primary=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
primary_branch=$(git -C "$primary" symbolic-ref --quiet --short HEAD || true)
if [[ $primary_branch != main ]]; then
  echo "gwt requires the primary worktree ($primary) to be on main (currently: ${primary_branch:-detached HEAD})." >&2
  echo "Switch the primary worktree to main before using gwt." >&2
  exit 1
fi

if [[ $delete_worktree == 1 && $branch == . ]]; then
  branch=$(git symbolic-ref --quiet --short HEAD) || {
    echo 'Current worktree has no branch.' >&2
    exit 1
  }
fi

if [[ $create_branch == 0 ]] && git show-ref --verify --quiet "refs/remotes/$branch"; then
  local_branch=${branch#*/}
  if [[ $local_branch == HEAD ]]; then
    echo 'Select a branch, not remote HEAD.' >&2
    exit 1
  fi
else
  local_branch=$branch
fi

if [[ $create_branch == 1 ]]; then
  if git show-ref --verify --quiet "refs/heads/$branch" ||
    git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    echo "Branch already exists: $branch" >&2
    exit 1
  fi
elif ! git show-ref --verify --quiet "refs/heads/$local_branch" &&
  ! git show-ref --verify --quiet "refs/remotes/$branch"; then
  echo "Branch not found: $branch (use gwt -b $branch to create it)" >&2
  exit 1
fi

existing=$(git worktree list --porcelain | awk -v ref="refs/heads/$local_branch" '
  /^worktree / { path = substr($0, 10) }
  /^branch / && substr($0, 8) == ref { print path; exit }
')
if [[ $delete_worktree == 1 ]]; then
  if [[ -z $existing ]]; then
    echo "No worktree for branch: $local_branch" >&2
    exit 1
  fi
  if [[ $existing == "$primary" ]]; then
    echo "Cannot remove the primary worktree: $primary" >&2
    exit 1
  fi
  current=$(git rev-parse --show-toplevel)
  git -C "$primary" worktree remove "$existing" >&2
  if [[ $current == "$existing" ]]; then
    printf '%s\n' "$primary"
  else
    printf '%s\n' "$current"
  fi
  exit 0
fi

if [[ -n $existing ]]; then
  printf '%s\n' "$existing"
  exit 0
fi

# Use the origin namespace without distinguishing GitHub from GHE.
origin_url=$(git remote get-url origin) || {
  echo 'Origin remote is required for creating a worktree.' >&2
  exit 1
}
# Accept SSH scp-style, ssh:// and https:// remotes.
case "$origin_url" in
*://*)
  remote_path=${origin_url#*://}
  remote_path=${remote_path#*/}
  ;;
*:*)
  remote_path=${origin_url#*:}
  ;;
*)
  echo "Unsupported origin URL: $origin_url" >&2
  exit 1
  ;;
esac
remote_path=${remote_path%.git}
remote_path=${remote_path%/}
if [[ $remote_path =~ ^([^/]+)/([^/]+)$ ]]; then
  owner=${BASH_REMATCH[1]}
  repo=${BASH_REMATCH[2]}
else
  echo "Expected origin URL ending in owner/repo: $origin_url" >&2
  exit 1
fi
target="$HOME/worktrees/$owner/$repo/$local_branch"
mkdir -p "$(dirname "$target")"
if [[ $create_branch == 1 ]]; then
  git worktree add -b "$local_branch" "$target" main >&2
elif git show-ref --verify --quiet "refs/heads/$local_branch"; then
  git worktree add "$target" "$local_branch" >&2
else
  git worktree add --track -b "$local_branch" "$target" "$branch" >&2
fi
printf '%s\n' "$target"
