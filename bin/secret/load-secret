#!/usr/bin/env bash
# Print a 1Password secret named in ~/.config/secret/secrets.conf, caching it
# for 30 minutes. The load-secret shell function (home/.shell.d/secret.sh)
# exports the output, since a program cannot change its parent's environment.
#
# ~/.config/secret/secrets.conf: KEY=op://Vault/Item/field (one per line)
# Usage: load-secret [ENV_NAME] (no arguments: list available names)
# Keep compatible with macOS's bash 3.2.
set -u

[[ $# -le 1 ]] || {
  printf 'Usage: load-secret [ENV_NAME]\n' >&2
  exit 2
}

name=${1:-} ref=''
config="$HOME/.config/secret/secrets.conf"
[[ -r $config ]] || {
  printf 'load-secret: cannot read %s\n' "$config" >&2
  exit 1
}
if [[ -z $name ]]; then
  while IFS='=' read -r key value || [[ -n $key ]]; do
    [[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ && $value == op://* ]] &&
      printf '%s\n' "$key"
  done < "$config"
  exit 0
fi
[[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
  printf 'Usage: load-secret [ENV_NAME]\n' >&2
  exit 2
}

while IFS='=' read -r key value || [[ -n $key ]]; do
  if [[ $key == "$name" ]]; then
    ref=$value
    break
  fi
done < "$config"
[[ $ref == op://* ]] || {
  printf 'load-secret: no reference for %s\n' "$name" >&2
  exit 1
}

root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[[ -d $root ]] || root=${TMPDIR:-}
[[ $root == /* && -d $root ]] || {
  printf 'load-secret: no runtime directory\n' >&2
  exit 1
}
root="$root/secret-cache"
[[ ! -L $root ]] || exit 1
(
  umask 077
  mkdir -p -- "$root"
) || exit 1
# No "--": BSD chmod (macOS) takes it as a file name after the mode. The
# absolute path above cannot be mistaken for an option.
chmod 700 "$root" || exit 1

if command -v sha256sum > /dev/null 2>&1; then
  hash=$(printf '%s' "$ref" | sha256sum) || exit 1
else
  hash=$(printf '%s' "$ref" | shasum -a 256) || exit 1
fi
file="$root/$name-${hash%% *}"
now=$(date +%s) || exit 1
if [[ -f $file && ! -L $file ]]; then
  mtime=$(stat -c %Y "$file" 2> /dev/null) ||
    mtime=$(stat -f %m "$file" 2> /dev/null) || exit 1
  if ((now >= mtime && now - mtime < 1800)); then
    cat -- "$file"
    exit
  fi
fi

command -v op > /dev/null 2>&1 || {
  printf 'load-secret: op not installed\n' >&2
  exit 1
}
if ! value=$(op read "$ref"); then
  # Point at the fix only when the cause is a missing sign-in; other
  # failures (wrong reference, no access) keep op's own message.
  # shellcheck disable=SC2016 # the command is printed, not run
  op whoami > /dev/null 2>&1 ||
    printf 'load-secret: not signed in to 1Password; run: eval "$(op signin)"\n' >&2
  exit 1
fi
[[ -n $value ]] || exit 1
tmp=$(
  umask 077
  mktemp "$root/.secret.XXXXXXXX"
) || exit 1
if ! printf '%s' "$value" > "$tmp" || ! mv -f -- "$tmp" "$file"; then
  rm -f -- "$tmp"
  exit 1
fi
printf '%s' "$value"
