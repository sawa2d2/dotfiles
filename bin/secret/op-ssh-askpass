#!/usr/bin/env bash
# SSH_ASKPASS program: answer password prompts for hosts listed in
# ~/.config/secret/ssh-passwords.conf from 1Password, and ask everything else
# on the terminal as ssh itself would.
#
# Mapping file, one per line (the host is the one the password prompt shows:
# the HostName, or HostKeyAlias when set):
#   host=op://Vault/Item/password
#   user@host=op://Vault/Item/password   (wins over the plain host)
#
# Enabled by home/.shell.d/ssh.sh when the mapping file exists.
# Keep compatible with macOS's bash 3.2.
set -u

prompt=${1:-}
config="$HOME/.config/secret/ssh-passwords.conf"

# Print the secret reference mapped to $1, if any.
reference() {
  local key value
  [[ -r $config ]] || return 1
  while IFS='=' read -r key value || [[ -n $key ]]; do
    if [[ $key == "$1" && $value == op://* ]]; then
      printf '%s\n' "$value"
      return 0
    fi
  done < "$config"
  return 1
}

# Ask on the controlling terminal. $1 is yes to show what is typed.
ask_tty() {
  local reply
  { exec 3<> /dev/tty; } 2> /dev/null || exit 1
  printf '%s' "$prompt" >&3
  if [[ $1 == yes ]]; then
    IFS= read -r reply <&3 || exit 1
  else
    stty -echo <&3 2> /dev/null
    trap 'stty echo <&3 2> /dev/null' EXIT
    IFS= read -r reply <&3 || exit 1
    stty echo <&3 2> /dev/null
    printf '\n' >&3
  fi
  printf '%s\n' "$reply"
}

case ${SSH_ASKPASS_PROMPT:-} in
confirm)
  reply=$(ask_tty yes) || exit 1
  [[ $reply == [yY]* ]]
  exit
  ;;
none)
  # Notification only (e.g. touch your security key).
  { printf '%s\n' "$prompt" > /dev/tty; } 2> /dev/null
  exit 0
  ;;
esac

# Only prompts that ssh itself builds name the host. Keyboard-interactive
# prompts get a "(user@host) " prefix from ssh; the server writes the rest,
# so anything more than a plain "Password:" after it is not trusted.
user='' host=''
if [[ $prompt =~ ^([^@\ \']+)@([^\ \']+)"'s password: "$ ]]; then
  user=${BASH_REMATCH[1]} host=${BASH_REMATCH[2]}
elif [[ $prompt =~ ^\(([^@\ \)]+)@([^\ \)]+)\)\ [Pp]assword:\ ?$ ]]; then
  user=${BASH_REMATCH[1]} host=${BASH_REMATCH[2]}
fi

if [[ -n $host ]]; then
  ref=$(reference "$user@$host") || ref=$(reference "$host") || ref=
  if [[ -n $ref ]] && password=$(op read "$ref" 2> /dev/null) && [[ -n $password ]]; then
    printf '%s\n' "$password"
    exit 0
  fi
  [[ -z $ref ]] || { printf 'op-ssh-askpass: 1Password lookup failed for %s\n' "$host" > /dev/tty; } 2> /dev/null
fi

if [[ $prompt == *"(yes/no"* ]]; then
  ask_tty yes
else
  ask_tty no
fi
