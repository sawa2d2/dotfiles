[core]
    editor = nvim
    pager = delta

[alias]
    m = merge
    sqm = merge --ff --squash
    us = restore --staged
    br = branch
    bra = branch -a
    mkbr = checkout -b
    fxbr = branch -m
    rmbr = branch -D
    st = status -sb .
    sta = status -sb -uall
    df = diff
    dfh = diff HEAD
    dfm = diff origin/main..HEAD
    t = tag
    a = add
    aa = add -A
    ap = add -p
    cm = commit -m
    fxcm = commit --amend -m
    cncm = commit --amend -m
    rmcm = commit --amend -m
    fe = fetch
    ph = push -u origin HEAD
    rb = rebase -i
    co = checkout
    sh = stash
    sha = stash -u
    shp = stash pop
    rs = reset
    sb = show-branch
    sba = show-branch --all
    wt = worktree
    se = browse
    pr = pull-request
    fk = fork
    gr = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    gra = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

[push]
    default = current

[merge]
    conflictStyle = zdiff3

[pull]
    ff = only

[delta]
    side-by-side = true
    line-numbers = true
    navigate = true
    syntax-theme = Catppuccin Mocha
    plus-style = syntax "#276C46"
    minus-style = syntax "#803D49"
    plus-emph-style = syntax "#32965C"
    minus-emph-style = syntax "#AD4659"

[interactive]
    diffFilter = delta --color-only

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[ghq]
    root = ~/repo

