#!/usr/bin/env bash
set -euo pipefail

# Use Vim's native package loader (Vim 8+).
plugin_dir="${HOME:?}/.vim/pack/dotfiles/start"
dest="$plugin_dir/ale"

command -v git >/dev/null 2>&1 || { echo 'git is required' >&2; exit 1; }
mkdir -p "$plugin_dir"
if [[ -d "$dest" || -L "$dest" ]]; then
  echo "Already present: $dest"
elif [[ -e "$dest" ]]; then
  echo "Cannot install plugin over existing file: $dest" >&2
  exit 1
else
  git clone --depth 1 https://github.com/dense-analysis/ale.git "$dest"
fi
