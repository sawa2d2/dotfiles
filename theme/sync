#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <teal|violet|orange|blue|red|green>" >&2
    exit 2
fi

THEME_VARIANT=$1
case "$THEME_VARIANT" in
    teal|violet|orange|blue|red|green) ;;
    *) echo "Unknown theme: $THEME_VARIANT" >&2; exit 2 ;;
esac

source "$ROOT/theme/colors.sh"
mkdir -p "$ROOT/theme/generated"

# Generate tmux theme.
cat > "$ROOT/.tmux.theme.conf" <<TMUX
# Generated by theme/sync. Do not edit.
set -g @color_bg '$COLOR_BG'
set -g @color_fg '$COLOR_FG'
set -g @color_accent '$COLOR_ACCENT'
set -g @color_active '$COLOR_ACTIVE'
set -g @color_inactive '$COLOR_INACTIVE'
set -g @color_white '$COLOR_WHITE'
set -g @color_prefix '$COLOR_PREFIX'
set -g @color_border_active '$COLOR_BORDER_ACTIVE'
TMUX

# Generate Bash prompt colors.
# Bash requires \[ \] around non-printing ANSI sequences.
{
    echo '# Generated by theme/sync. Do not edit.'
    for name in CLEAN DIRTY STAGED MIXED; do
        var="COLOR_GIT_$name"
        hex=${!var#\#}

        printf -v rgb '%d;%d;%d' \
            "0x${hex:0:2}" \
            "0x${hex:2:2}" \
            "0x${hex:4:2}"

        printf "_PROMPT_GIT_%s='\\\\[\\\\e[1;38;2;%sm\\\\]'\n" \
            "$name" "$rgb"
    done
    printf "_PROMPT_RESET='\\\\[\\\\e[0m\\\\]'\n"
} > "$ROOT/theme/generated/bash-prompt.bash"

# Generate Zsh prompt colors.
{
    echo '# Generated by theme/sync. Do not edit.'
    for name in CLEAN DIRTY STAGED MIXED; do
        var="COLOR_GIT_$name"
        printf "_PROMPT_GIT_%s='%s'\n" "$name" "${!var}"
    done
} > "$ROOT/theme/generated/zsh-prompt.zsh"

# Generate Vim UI overlay without replacing the colorscheme.
cat > "$ROOT/.vim.theme.vim" <<VIM
" Generated by theme/sync. Do not edit.
if has('termguicolors')
  set termguicolors
endif
highlight StatusLine guifg=$COLOR_WHITE guibg=$COLOR_ACTIVE
highlight StatusLineNC guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight Visual guifg=$COLOR_FG guibg=$COLOR_SELECTED
highlight Search guifg=$COLOR_FG guibg=$COLOR_SELECTED
VIM


# Generate fzf options from the same palette used by peco.
cat > "$ROOT/theme/generated/fzf.sh" <<FZF
# Generated by theme/sync. Do not edit.
export FZF_DEFAULT_OPTS="\${FZF_DEFAULT_OPTS:+\$FZF_DEFAULT_OPTS }--layout=default --bind=ctrl-j:down,ctrl-k:up --color=fg:$COLOR_WHITE,bg:$COLOR_ACTIVE,fg+:$COLOR_FG,bg+:$COLOR_SELECTED,hl:$COLOR_ACCENT,hl+:$COLOR_FG,prompt:$COLOR_ACCENT,pointer:$COLOR_ACCENT,info:$COLOR_INACTIVE,border:$COLOR_INACTIVE"
FZF

# Update installed peco colors, preserving Layout and Keymap.
PECO="$HOME/.config/peco/config.json"

if [[ -f "$PECO" ]]; then
    PECO_PATH="$PECO" \
    PECO_SELECTED="$COLOR_SELECTED" \
    python3 - <<'PY'
import json
import os
from pathlib import Path

# Resolve symlinks so the installed link remains intact.
path = Path(os.environ["PECO_PATH"]).resolve()
selected = os.environ["PECO_SELECTED"]

settings = json.loads(path.read_text(encoding="utf-8"))
style = settings.setdefault("Style", {})

for name in ("Selected", "SavedSelection"):
    if name in style:
        style[name] = [
            f"on_{selected}" if str(value).startswith("on_") else value
            for value in style[name]
        ]

for name in ("Matched", "Prompt"):
    if name in style:
        style[name] = [
            selected if isinstance(value, str) and value.startswith("#") else value
            for value in style[name]
        ]

path.write_text(
    json.dumps(settings, indent=2, ensure_ascii=False) + "\n",
    encoding="utf-8",
)
PY

    echo "Updated peco colors: $PECO"
else
    echo "peco config not found (skipped): $PECO" >&2
fi

printf '%s\n' 'Generated tmux, Bash, Zsh and Vim themes.'

# Reload tmux configuration if a server is running.
if command -v tmux >/dev/null 2>&1 &&
   tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "$HOME/.tmux.conf"
fi