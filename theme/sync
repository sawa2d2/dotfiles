#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <teal|violet|orange|blue|red|green>" >&2
    exit 2
fi

THEME_VARIANT=$1
case "$THEME_VARIANT" in
    teal|violet|orange|blue|red|green) ;;
    *) echo "Unknown theme: $THEME_VARIANT" >&2; exit 2 ;;
esac

source "$ROOT/theme/colors.sh"
mkdir -p "$ROOT/theme/generated"

# tmux reads the theme before formatting its status line.
cat > "$ROOT/.tmux.theme.conf" <<TMUX
# Generated by theme/sync. Do not edit.
set -g @color_bg '$COLOR_BG'
set -g @color_fg '$COLOR_FG'
set -g @color_accent '$COLOR_ACCENT'
set -g @color_active '$COLOR_ACTIVE'
set -g @color_inactive '$COLOR_INACTIVE'
set -g @color_white '$COLOR_WHITE'
set -g @color_prefix '$COLOR_PREFIX'
set -g @color_border_active '$COLOR_BORDER_ACTIVE'
TMUX

# Bash prompts require \[ \] around non-printing ANSI escapes.
{
    echo '# Generated by theme/sync. Do not edit.'
    for name in CLEAN DIRTY STAGED MIXED; do
        var="COLOR_GIT_$name"
        hex=${!var#\#}
        printf -v rgb '%d;%d;%d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
        printf "_PROMPT_GIT_%s='\\\\[\\\\e[1;38;2;%sm\\\\]'\n" "$name" "$rgb"
    done
    printf "_PROMPT_RESET='\\\\[\\\\e[0m\\\\]'\n"
} > "$ROOT/theme/generated/bash-prompt.bash"

# A small Vim UI overlay: doesn't replace the existing colorscheme.
cat > "$ROOT/.vim.theme.vim" <<VIM
" Generated by theme/sync. Do not edit.
if has('termguicolors')
  set termguicolors
endif
highlight StatusLine guifg=$COLOR_WHITE guibg=$COLOR_ACTIVE
highlight StatusLineNC guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight Visual guifg=$COLOR_FG guibg=$COLOR_SELECTED
highlight Search guifg=$COLOR_FG guibg=$COLOR_SELECTED
VIM

# Update only peco's Style palette, preserving Layout and Keymap.
PECO="$ROOT/private.d/config.d/peco/config.json"
if [[ -f "$PECO" ]]; then
    PECO_PATH="$PECO" PECO_SELECTED="$COLOR_SELECTED" python3 - <<'PY'
import json, os, pathlib
path = pathlib.Path(os.environ['PECO_PATH'])
settings = json.loads(path.read_text(encoding='utf-8'))
selected = os.environ['PECO_SELECTED']
style = settings.setdefault('Style', {})
for name in ('Selected', 'SavedSelection'):
    if name in style:
        style[name] = [f'on_{selected}' if str(v).startswith('on_') else v for v in style[name]]
for name in ('Matched', 'Prompt'):
    if name in style:
        style[name] = [selected if isinstance(v, str) and v.startswith('#') else v for v in style[name]]
path.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')
PY
    echo "Updated peco colors: $PECO"
else
    echo "peco config not found (skipped): $PECO" >&2
fi
printf '%s\n' 'Generated tmux, Bash and Vim themes.'
