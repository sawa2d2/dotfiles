#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 <teal|violet|orange|blue|red|green>" >&2
    exit 2
fi

THEME_VARIANT=$1
case "$THEME_VARIANT" in
    teal|violet|orange|blue|red|green) ;;
    *) echo "Unknown theme: $THEME_VARIANT" >&2; exit 2 ;;
esac

source "$ROOT/theme/colors.sh"
mkdir -p "$ROOT/theme/generated"

# Generate tmux theme.
cat > "$ROOT/theme/generated/tmux.theme.conf" <<TMUX
# Generated by theme/sync. Do not edit.
set -g @color_bg '$COLOR_BG'
set -g @color_fg '$COLOR_FG'
set -g @color_accent '$COLOR_ACCENT'
set -g @color_active '$COLOR_ACTIVE'
set -g @color_inactive '$COLOR_INACTIVE'
set -g @color_white '$COLOR_WHITE'
set -g @color_prefix '$COLOR_PREFIX'
set -g @color_border_active '$COLOR_BORDER_ACTIVE'
TMUX

# Generate Bash prompt colors.
# Bash requires \[ \] around non-printing ANSI sequences.
{
    echo '# Generated by theme/sync. Do not edit.'
    for name in CLEAN DIRTY STAGED MIXED; do
        var="COLOR_GIT_$name"
        hex=${!var#\#}

        printf -v rgb '%d;%d;%d' \
            "0x${hex:0:2}" \
            "0x${hex:2:2}" \
            "0x${hex:4:2}"

        printf "_PROMPT_GIT_%s='\\\\[\\\\e[1;38;2;%sm\\\\]'\n" \
            "$name" "$rgb"
    done
    printf "_PROMPT_RESET='\\\\[\\\\e[0m\\\\]'\n"
} > "$ROOT/theme/generated/bash-prompt.bash"

# Generate Zsh prompt colors.
{
    echo '# Generated by theme/sync. Do not edit.'
    for name in CLEAN DIRTY STAGED MIXED; do
        var="COLOR_GIT_$name"
        printf "_PROMPT_GIT_%s='%s'\n" "$name" "${!var}"
    done
} > "$ROOT/theme/generated/zsh-prompt.zsh"

# Generate Vim UI overlay without replacing the colorscheme.
cat > "$ROOT/theme/generated/vim.theme.vim" <<VIM
" Generated by theme/sync. Do not edit.
if has('termguicolors')
  set termguicolors
endif
highlight DotCmpNormal guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight DotCmpSelected guifg=$COLOR_FG guibg=$COLOR_SELECTED gui=bold
highlight Pmenu guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight PmenuSel guifg=$COLOR_FG guibg=$COLOR_SELECTED gui=bold
highlight PmenuSbar guibg=$COLOR_INACTIVE
highlight PmenuThumb guibg=$COLOR_ACTIVE
highlight CmpItemAbbr guifg=$COLOR_FG guibg=NONE
highlight CmpItemAbbrMatch guifg=$COLOR_PREFIX guibg=NONE gui=bold
highlight CmpItemAbbrMatchFuzzy guifg=$COLOR_PREFIX guibg=NONE gui=bold
highlight CmpItemKind guifg=$COLOR_PREFIX guibg=NONE gui=bold
highlight CmpItemMenu guifg=$COLOR_ACTIVE guibg=NONE
highlight NormalFloat guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight LineNr guibg=#484b4e ctermbg=238
highlight CursorLineNr guibg=#484b4e ctermbg=238
highlight SignColumn guibg=#484b4e ctermbg=238
highlight DotfilesHoverPadding guifg=$COLOR_INACTIVE guibg=$COLOR_INACTIVE
highlight StatusLine guifg=$COLOR_WHITE guibg=$COLOR_ACTIVE
highlight StatusLineNC guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight DotStatusMode guifg=$COLOR_FG guibg=$COLOR_ACCENT gui=bold
highlight DotStatusFile guifg=$COLOR_WHITE guibg=$COLOR_ACTIVE gui=bold
highlight DotStatusMeta guifg=$COLOR_FG guibg=$COLOR_SELECTED
highlight TabLineSel guifg=$COLOR_WHITE guibg=$COLOR_ACTIVE gui=bold
highlight TabLine guifg=$COLOR_FG guibg=$COLOR_INACTIVE
highlight TabLineFill guibg=$COLOR_INACTIVE
" Git gutter colors, shared across all theme variants.
highlight GitSignsAdd guifg=$COLOR_GIT_CLEAN
highlight GitSignsChange guifg=$COLOR_GIT_STAGED
highlight GitSignsDelete guifg=$COLOR_GIT_MIXED
highlight GitSignsTopdelete guifg=$COLOR_GIT_MIXED
highlight GitSignsChangedelete guifg=$COLOR_GIT_MIXED
highlight GitSignsUntracked guifg=$COLOR_GIT_CLEAN
highlight DotTabError guifg=$COLOR_DIAG_ERROR guibg=$COLOR_ACTIVE gui=bold
highlight DotTabWarn guifg=$COLOR_DIAG_WARN guibg=$COLOR_ACTIVE gui=bold
highlight DotTabErrorNC guifg=$COLOR_DIAG_ERROR_INACTIVE guibg=$COLOR_INACTIVE
highlight DotTabWarnNC guifg=$COLOR_DIAG_WARN_INACTIVE guibg=$COLOR_INACTIVE
highlight DotStatusError guifg=$COLOR_DIAG_ERROR guibg=$COLOR_ACTIVE gui=bold
highlight DotStatusWarn guifg=$COLOR_DIAG_WARN guibg=$COLOR_ACTIVE gui=bold
highlight DotStatusErrorNC guifg=$COLOR_DIAG_ERROR_INACTIVE guibg=$COLOR_INACTIVE
highlight DotStatusWarnNC guifg=$COLOR_DIAG_WARN_INACTIVE guibg=$COLOR_INACTIVE
highlight Visual guifg=$COLOR_FG guibg=$COLOR_SELECTED
highlight Search guifg=$COLOR_FG guibg=$COLOR_SELECTED
VIM


# fzf reads this file on each invocation, so theme/sync takes effect immediately.
cat > "$ROOT/theme/generated/fzf.opts" <<FZF
--layout=default --bind=ctrl-j:down,ctrl-k:up --color=fg:$COLOR_WHITE,bg:$COLOR_ACTIVE,fg+:$COLOR_FG,bg+:$COLOR_SELECTED,hl:$COLOR_ACCENT,hl+:$COLOR_FG,prompt:$COLOR_ACCENT,pointer:$COLOR_ACCENT,info:$COLOR_INACTIVE,border:$COLOR_INACTIVE
FZF

printf '%s\n' 'Generated tmux, Bash, Zsh and Vim themes.'

# Reload tmux configuration if a server is running.
if command -v tmux >/dev/null 2>&1 &&
   tmux list-sessions >/dev/null 2>&1 &&
   [ -f "$HOME/.tmux.conf" ] &&
   [ -f "$ROOT/theme/generated/tmux.theme.conf" ]; then
    tmux source-file "$HOME/.tmux.conf"
fi