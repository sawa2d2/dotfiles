# Defaults for projects without their own EditorConfig.
# Project-local .editorconfig files take precedence.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 2
# Matches bin/codeutil/shformat's -ci and -sr flags where supported.
case_indent = true
space_redirects = true

# shfmt also recognizes extensionless scripts with shell shebangs.
[[shell]]
indent_style = space
indent_size = 2
case_indent = true
space_redirects = true

[*.py]
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
