[core]
    editor = nvim
    pager = delta

[alias]
    m = merge
    us = restore --staged
    br = branch
    bra = branch -a
    mkbr = checkout -b
    fxbr = branch -m
    rmbr = branch -D
    st = status -sb .
    sta = status -sb -uall
    df = diff
    dfh = diff HEAD
    dfn = "!f() { git diff \"HEAD~${1:-1}\" \"HEAD~$((${1:-1}-1))\"; }; f"
    dff = "!f() { n=${1:-1}; git diff --name-only \"HEAD~$n\" \"HEAD~$((n-1))\"; }; f"
    t = tag
    a = add
    aa = add -A
    ap = add -p
    cm = commit -m
    fxcm = commit --amend -m
    cncm = commit --amend -m
    rmcm = commit --amend -m
    f = fetch
    ph = push -u origin HEAD
    rb = rebase -i
    co = checkout
    sh = stash
    sha = stash -u
    shp = stash pop
    rs = reset
    sb = show-branch
    sba = show-branch --all
    wt = worktree
    se = browse
    pr = pull-request
    fk = fork
    gr = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    gra = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

[pager]
    # Page the whole multi-command output of git-dfm once, through delta.
    dfm = true

[push]
    default = current

[merge]
    conflictStyle = zdiff3

[pull]
    ff = only

[fetch]
    prune = true

[delta]
    side-by-side = true
    line-numbers = true
    navigate = true
    syntax-theme = Catppuccin Mocha
    # Dark backgrounds keep Catppuccin Mocha text >= 6:1 and comments >= 3.2:1,
    # while changed lines and emphasized changes stay distinguishable.
    plus-style = syntax "#143724"
    minus-style = syntax "#4D252C"
    plus-emph-style = syntax "#1B5132"
    minus-emph-style = syntax "#77303D"
    # delta's defaults (#444444, 256-color 28/88, ANSI blue) are too dim on a
    # dark terminal.
    line-numbers-zero-style = "#7F849C"
    line-numbers-plus-style = "#A6E3A1"
    line-numbers-minus-style = "#EBA0AC"
    line-numbers-left-style = "#7F849C"
    line-numbers-right-style = "#7F849C"
    # ANSI blue follows the terminal palette (GNOME Tango #3465A4 is ~2.8:1);
    # highlight file names and use a fixed bright blue for decorations.
    file-style = bold "#1E1E2E" "#89B4FA"
    file-decoration-style = none
    hunk-header-decoration-style = "#89B4FA" box
    hunk-header-line-number-style = "#89B4FA"
    hunk-header-file-style = "#89B4FA"
    # Wrap markers in side-by-side view.
    inline-hint-style = "#7F849C"

[interactive]
    diffFilter = delta --color-only

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[ghq]
    root = ~/repo

