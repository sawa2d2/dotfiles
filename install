#!/usr/bin/env bash
set -euo pipefail

DOTPATH=$(cd "$(dirname "$0")" && pwd)

cd "$DOTPATH"

if [[ ${1:-} == --system ]]; then
    shift
    source "$DOTPATH/install-dotfiles-bin-system-wide"
    install_system_bin "$@"
    exit
fi
if (( $# != 0 )); then
    echo "Usage: ./install | sudo ./install --system [--dry-run]" >&2
    exit 2
fi

printf '\033[38;2;27;175;181m'
cat <<'EOF'
     _       _    __ _ _
  __| | ___ | |_ / _(_) | ___  ___
 / _` |/ _ \| __| |_| | |/ _ \/ __|
| (_| | (_) | |_|  _| | |  __/\__ \
 \__,_|\___/ \__|_| |_|_|\___||___/

EOF
printf '\033[0m'

# Create or update symlinks, but preserve real files/directories.
link() {
    src=$1
    dest=$2

    [ -e "$src" ] || [ -L "$src" ] || return 0

    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        echo "Skip existing: $dest"
        return 0
    fi

    ln -sfn "$src" "$dest"
    echo "Link: $dest"
}

# Shared configurations
link "$DOTPATH/.editorconfig" "$HOME/.editorconfig"
for f in \
    .gitconfig \
    .git.d \
    .x.d \
    .tmux.conf \
    .vimrc
do
    link "$DOTPATH/home/$f" "$HOME/$f"
done

# Refresh both shells: old symlinks may point to pre-migration paths.
for f in \
    .bashrc \
    .bash_aliases \
    .bash.d \
    .blerc \
    .inputrc \
    .shell.d \
    .zshrc \
    .zsh.d
do
    link "$DOTPATH/home/$f" "$HOME/$f"
done

# Executables
link "$DOTPATH/bin" "$HOME/bin"

# Install application configurations
if [[ -d "$DOTPATH/home/.config" ]]; then
    while IFS= read -r -d '' src; do
        relative="${src#"$DOTPATH/home/.config/"}"
        # VS Code has platform-specific User Settings paths.
        [[ "$relative" == vscode/* ]] && continue
        dst="$HOME/.config/$relative"
        mkdir -p "$(dirname "$dst")"
        link "$src" "$dst"
    done < <(find "$DOTPATH/home/.config" -type f -print0)
fi

# VS Code User files (settings and extension recommendations).
for vscode_file in settings.json extensions.json; do
    vscode_src="$DOTPATH/home/.config/vscode/$vscode_file"
    [[ -f "$vscode_src" ]] || continue
    case "$(uname -s)" in
        Darwin) vscode_dest="$HOME/Library/Application Support/Code/User/$vscode_file" ;;
        Linux)  vscode_dest="$HOME/.config/Code/User/$vscode_file" ;;
        *)      continue ;;
    esac

    mkdir -p "$(dirname "$vscode_dest")"
    if [[ -e "$vscode_dest" && ! -L "$vscode_dest" ]]; then
        backup="$vscode_dest.backup"
        backup_num=1
        while [[ -e "$backup" || -L "$backup" ]]; do
            backup="$vscode_dest.backup.$backup_num"
            backup_num=$((backup_num + 1))
        done
        mv "$vscode_dest" "$backup"
        echo "Backup: $vscode_dest"
    fi
    link "$vscode_src" "$vscode_dest"
done

# Generate shared theme
if [ -x "$DOTPATH/theme/sync" ]; then
    echo "Generate theme configurations"
    "$DOTPATH/theme/sync" teal

    # Remove obsolete symlinks from the old theme output locations.
    for theme_file in .tmux.theme.conf .vim.theme.vim; do
        theme_link="$HOME/$theme_file"
        if [[ -L "$theme_link" ]]; then
            theme_target=$(readlink "$theme_link")
            if [[ "$theme_target" == "$DOTPATH/"* ]]; then
                unlink "$theme_link"
            fi
        fi
    done

    # Reload an existing tmux server using the generated theme.
    if command -v tmux >/dev/null 2>&1 &&
       tmux list-sessions >/dev/null 2>&1 &&
       [ -f "$HOME/.tmux.conf" ] &&
       [ -f "$DOTPATH/theme/generated/tmux.theme.conf" ]; then
        tmux source-file "$HOME/.tmux.conf"
    fi
fi

# Private configuration
if [ -f "$DOTPATH/private.d/install" ]; then
    echo "Install private configuration"
    "$DOTPATH/private.d/install"
fi

