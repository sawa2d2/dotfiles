#!/usr/bin/env bash
set -euo pipefail

DOTPATH=$(cd "$(dirname "$0")" && pwd)
DEFAULT_SHELL=$(basename "${SHELL:-/bin/sh}")

cd "$DOTPATH"

if [[ ${1:-} == --system ]]; then
    shift
    source "$DOTPATH/install-dotfiles-bin.sh"
    install_system_bin "$@"
    exit
fi
if (( $# != 0 )); then
    echo "Usage: ./install | sudo ./install --system [--dry-run]" >&2
    exit 2
fi

printf '\033[38;2;27;175;181m'
cat <<'EOF'
     _       _    __ _ _
  __| | ___ | |_ / _(_) | ___  ___
 / _` |/ _ \| __| |_| | |/ _ \/ __|
| (_| | (_) | |_|  _| | |  __/\__ \
 \__,_|\___/ \__|_| |_|_|\___||___/

EOF
printf '\033[0m'

# Create or update symlinks, but preserve real files/directories.
link() {
    src=$1
    dest=$2

    [ -e "$src" ] || [ -L "$src" ] || return 0

    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        echo "Skip existing: $dest"
        return 0
    fi

    ln -sfn "$src" "$dest"
    echo "Link: $dest"
}

# Shared configurations
for f in \
    .editorconfig \
    .gitconfig \
    .git.d \
    .profile_common \
    .tmux.conf \
    .vimrc
do
    link "$DOTPATH/$f" "$HOME/$f"
done

# Shell-specific configurations
case "$DEFAULT_SHELL" in
    bash)
        for f in \
            .bashrc \
            .bash_aliases \
            .bash.d \
            .blerc \
            .inputrc
        do
            link "$DOTPATH/$f" "$HOME/$f"
        done
        ;;
    zsh)
        for f in \
            .zshrc \
            .zsh.d
        do
            link "$DOTPATH/$f" "$HOME/$f"
        done
        ;;
esac

# Executables
link "$DOTPATH/bin" "$HOME/bin"

# Install application configurations
if [[ -d "$DOTPATH/config.d" ]]; then
    while IFS= read -r -d '' src; do
        relative="${src#"$DOTPATH/config.d/"}"
        dst="$HOME/.config/$relative"
        mkdir -p "$(dirname "$dst")"
        link "$src" "$dst"
    done < <(find "$DOTPATH/config.d" -type f -print0)
fi

# Generate shared theme
if [ -x "$DOTPATH/theme/sync" ]; then
    echo "Generate theme configurations"
    "$DOTPATH/theme/sync" teal

    link "$DOTPATH/.tmux.theme.conf" "$HOME/.tmux.theme.conf"
    link "$DOTPATH/.vim.theme.vim" "$HOME/.vim.theme.vim"

    # A previous repository location can leave the theme symlink broken.
    # Reload again after relinking so an existing tmux session picks up the theme.
    if command -v tmux >/dev/null 2>&1 &&
       tmux list-sessions >/dev/null 2>&1 &&
       [ -f "$HOME/.tmux.conf" ] &&
       [ -f "$HOME/.tmux.theme.conf" ]; then
        tmux source-file "$HOME/.tmux.conf"
    fi
fi

# Private configuration
if [ -f "$DOTPATH/private.d/install" ]; then
    echo "Install private configuration"
    "$DOTPATH/private.d/install"
fi

